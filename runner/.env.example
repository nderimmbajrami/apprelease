# Copy to .env (git-ignored) or export in the shell that starts the runner.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SECRETS_KEY=<the same value given to the store-secret function>
RUNNER_NAME=mac-m2-01
RUNNER_PLATFORMS=android,ios     # what this machine can build
RUNNER_WORKSPACE=./workspace     # where repositories are checked out
