# Copy to .env (git-ignored) or export in the shell that starts the runner.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SECRETS_KEY=<the same value given to the store-secret function>
RUNNER_NAME=mac-m2-01
RUNNER_PLATFORMS=android,ios     # what this machine can build
RUNNER_WORKSPACE=./workspace     # where repositories are checked out

# Previews ("see it on my phone"). Leave out on a machine that builds none.
PREVIEW_DIR=./previews                         # where the APK and web build are written
PREVIEW_BASE_URL=https://preview.example.com   # the public address of that folder
PREVIEW_KEEP_DAYS=7                            # older previews are deleted
PREVIEW_PORT=8787                              # for bin/serve_previews.dart
